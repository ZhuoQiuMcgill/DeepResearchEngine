{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "web_search": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query"
      ],
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "max_results": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 5
        }
      }
    },
    "scholar_crossref_search": {
      "$ref": "#/$defs/web_search"
    },
    "scholar_openalex_search": {
      "$ref": "#/$defs/web_search"
    },
    "web_fetch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "mode": {
          "const": "static",
          "default": "static"
        }
      }
    },
    "document_range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "start",
        "end_exclusive"
      ],
      "properties": {
        "kind": {
          "enum": [
            "lines",
            "pages"
          ]
        },
        "start": {
          "type": "integer",
          "minimum": 1
        },
        "end_exclusive": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "document_read": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_ref",
        "range"
      ],
      "properties": {
        "snapshot_ref": {
          "$ref": "ebd-contract-v1#/$defs/SnapshotRef"
        },
        "range": {
          "$ref": "#/$defs/document_range"
        },
        "max_text_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536,
          "default": 65536
        },
        "continuation": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 8192,
          "default": null
        }
      }
    }
  }
}
