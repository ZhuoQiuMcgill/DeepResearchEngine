{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "identity_text": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 512
    },
    "short_text": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1024
    },
    "url": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 8192
    },
    "integer_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "crossref_link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "content_type",
        "content_version",
        "intended_application"
      ],
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "content_type": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "content_version": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "intended_application": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        }
      }
    },
    "crossref_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "titles",
        "doi",
        "doi_url",
        "member_id",
        "publisher",
        "work_type",
        "published_date_parts",
        "links"
      ],
      "properties": {
        "rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "titles": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "maxLength": 8192
          }
        },
        "doi": {
          "$ref": "#/$defs/identity_text"
        },
        "doi_url": {
          "$ref": "#/$defs/url"
        },
        "member_id": {
          "type": [
            "string",
            "integer",
            "null"
          ],
          "maxLength": 512,
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "publisher": {
          "$ref": "#/$defs/short_text"
        },
        "work_type": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "published_date_parts": {
          "anyOf": [
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9999
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "links": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/crossref_link"
          }
        }
      }
    },
    "openalex_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "display_name",
        "source_type",
        "host_organization_id",
        "host_organization_name",
        "is_oa"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/identity_text"
        },
        "display_name": {
          "$ref": "#/$defs/short_text"
        },
        "source_type": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "host_organization_id": {
          "$ref": "#/$defs/identity_text"
        },
        "host_organization_name": {
          "$ref": "#/$defs/short_text"
        },
        "is_oa": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "openalex_location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "location_id",
        "landing_page_url",
        "pdf_url",
        "is_oa",
        "version",
        "license",
        "source"
      ],
      "properties": {
        "location_id": {
          "$ref": "#/$defs/identity_text"
        },
        "landing_page_url": {
          "$ref": "#/$defs/url"
        },
        "pdf_url": {
          "$ref": "#/$defs/url"
        },
        "is_oa": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "license": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/openalex_source"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "open_access": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "is_oa",
        "oa_status",
        "oa_url"
      ],
      "properties": {
        "is_oa": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "oa_status": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "oa_url": {
          "$ref": "#/$defs/url"
        }
      }
    },
    "openalex_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "work_id",
        "title",
        "doi_url",
        "publication_year",
        "open_access",
        "primary_location",
        "best_oa_location",
        "locations"
      ],
      "properties": {
        "rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "work_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 8192
        },
        "doi_url": {
          "$ref": "#/$defs/url"
        },
        "publication_year": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9999
        },
        "open_access": {
          "anyOf": [
            {
              "$ref": "#/$defs/open_access"
            },
            {
              "type": "null"
            }
          ]
        },
        "primary_location": {
          "anyOf": [
            {
              "$ref": "#/$defs/openalex_location"
            },
            {
              "type": "null"
            }
          ]
        },
        "best_oa_location": {
          "anyOf": [
            {
              "$ref": "#/$defs/openalex_location"
            },
            {
              "type": "null"
            }
          ]
        },
        "locations": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/openalex_location"
          }
        }
      }
    },
    "crossref_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "scope",
        "query",
        "searched_at",
        "discovery_only",
        "provider_total_results",
        "results"
      ],
      "properties": {
        "provider": {
          "const": "crossref"
        },
        "scope": {
          "const": "scholarly_metadata"
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "searched_at": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        "discovery_only": {
          "const": true
        },
        "provider_total_results": {
          "$ref": "#/$defs/integer_count"
        },
        "results": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/crossref_candidate"
          }
        }
      }
    },
    "openalex_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "scope",
        "query",
        "searched_at",
        "discovery_only",
        "provider_total_results",
        "results"
      ],
      "properties": {
        "provider": {
          "const": "openalex"
        },
        "scope": {
          "const": "scholarly_metadata"
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "searched_at": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        "discovery_only": {
          "const": true
        },
        "provider_total_results": {
          "$ref": "#/$defs/integer_count"
        },
        "results": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/openalex_candidate"
          }
        }
      }
    },
    "scholar_error_details": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "http_status",
        "reason",
        "observed_requests",
        "observed_responses",
        "response_transfer_bytes",
        "response_decoded_bytes",
        "quota_source",
        "remaining_microusd",
        "reset_at",
        "retry_after_seconds"
      ],
      "properties": {
        "provider": {
          "enum": [
            "crossref",
            "openalex"
          ]
        },
        "http_status": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 100,
          "maximum": 599
        },
        "reason": {
          "enum": [
            "invalid_arguments",
            "local_quota_exhausted",
            "remote_quota_exhausted",
            "http_forbidden",
            "rate_limited",
            "auth_required",
            "unexpected_redirect",
            "http_error",
            "transport_unavailable",
            "invalid_provider_response",
            "response_limit",
            "deadline",
            "cancelled",
            "quota_policy_changed"
          ]
        },
        "observed_requests": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "observed_responses": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "response_transfer_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "response_decoded_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "quota_source": {
          "enum": [
            "local",
            "remote",
            "both",
            null
          ]
        },
        "remaining_microusd": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reset_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "maxLength": 64
        },
        "retry_after_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 172800
        }
      }
    },
    "scholarly_attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "endpoint_id",
        "http_request_count",
        "http_response_count",
        "http_status",
        "response_transfer_bytes",
        "response_decoded_bytes",
        "duration_ms"
      ],
      "properties": {
        "provider": {
          "enum": [
            "crossref",
            "openalex"
          ]
        },
        "endpoint_id": {
          "enum": [
            "crossref_works_public",
            "openalex_works_anonymous"
          ]
        },
        "http_request_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "http_response_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "http_status": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 100,
          "maximum": 599
        },
        "response_transfer_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "response_decoded_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "duration_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "quota_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_scope",
        "reservation_id",
        "local_utc_bucket",
        "reserved_microusd",
        "local_remaining_microusd",
        "provider_reported_remaining_microusd",
        "provider_reported_cost_microusd",
        "effective_min_interval_ms",
        "reset_at",
        "retry_after_seconds",
        "admission_blocked"
      ],
      "properties": {
        "owner_scope": {
          "const": "executor_local"
        },
        "reservation_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "local_utc_bucket": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "reserved_microusd": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "local_remaining_microusd": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "provider_reported_remaining_microusd": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "provider_reported_cost_microusd": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "effective_min_interval_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reset_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "maxLength": 64
        },
        "retry_after_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 172800
        },
        "admission_blocked": {
          "type": "boolean"
        }
      }
    },
    "remote_header_value": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "capture",
            "raw"
          ],
          "properties": {
            "capture": {
              "enum": [
                "single",
                "invalid"
              ]
            },
            "raw": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 128,
              "pattern": "^[ -~]*$"
            }
          },
          "oneOf": [
            {
              "properties": {
                "capture": {
                  "const": "single"
                },
                "raw": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "properties": {
                "capture": {
                  "const": "invalid"
                },
                "raw": {
                  "type": "null"
                }
              }
            }
          ]
        }
      ]
    },
    "worker_provider_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "crossref_rate_limit",
        "crossref_rate_interval",
        "crossref_concurrency_limit",
        "openalex_limit_usd",
        "openalex_remaining_usd",
        "openalex_cost_usd",
        "openalex_limit_credits",
        "openalex_remaining_credits",
        "openalex_cost_credits",
        "openalex_reset_seconds",
        "retry_after"
      ],
      "properties": {
        "crossref_rate_limit": {
          "$ref": "#/$defs/remote_header_value"
        },
        "crossref_rate_interval": {
          "$ref": "#/$defs/remote_header_value"
        },
        "crossref_concurrency_limit": {
          "$ref": "#/$defs/remote_header_value"
        },
        "openalex_limit_usd": {
          "$ref": "#/$defs/remote_header_value"
        },
        "openalex_remaining_usd": {
          "$ref": "#/$defs/remote_header_value"
        },
        "openalex_cost_usd": {
          "$ref": "#/$defs/remote_header_value"
        },
        "openalex_limit_credits": {
          "$ref": "#/$defs/remote_header_value"
        },
        "openalex_remaining_credits": {
          "$ref": "#/$defs/remote_header_value"
        },
        "openalex_cost_credits": {
          "$ref": "#/$defs/remote_header_value"
        },
        "openalex_reset_seconds": {
          "$ref": "#/$defs/remote_header_value"
        },
        "retry_after": {
          "$ref": "#/$defs/remote_header_value"
        }
      }
    },
    "provider_limit_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rate_limit_requests",
        "rate_interval_ms",
        "concurrency_limit",
        "budget_limit_microusd",
        "remaining_microusd",
        "cost_microusd",
        "credit_limit",
        "remaining_credits",
        "cost_credits",
        "currency",
        "credit_unit",
        "reset_at",
        "retry_after_seconds",
        "missing_fields",
        "invalid_fields",
        "reset_after_seconds"
      ],
      "properties": {
        "rate_limit_requests": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "rate_interval_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "concurrency_limit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "budget_limit_microusd": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "remaining_microusd": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cost_microusd": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "credit_limit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "remaining_credits": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cost_credits": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "currency": {
          "enum": [
            "USD",
            null
          ]
        },
        "credit_unit": {
          "enum": [
            "openalex_credit",
            null
          ]
        },
        "reset_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "maxLength": 64
        },
        "retry_after_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 172800
        },
        "missing_fields": {
          "type": "array",
          "maxItems": 11,
          "uniqueItems": true,
          "items": {
            "enum": [
              "crossref_rate_limit",
              "crossref_rate_interval",
              "crossref_concurrency_limit",
              "openalex_limit_usd",
              "openalex_remaining_usd",
              "openalex_cost_usd",
              "openalex_limit_credits",
              "openalex_remaining_credits",
              "openalex_cost_credits",
              "openalex_reset_seconds",
              "retry_after"
            ]
          }
        },
        "invalid_fields": {
          "type": "array",
          "maxItems": 11,
          "uniqueItems": true,
          "items": {
            "enum": [
              "crossref_rate_limit",
              "crossref_rate_interval",
              "crossref_concurrency_limit",
              "openalex_limit_usd",
              "openalex_remaining_usd",
              "openalex_cost_usd",
              "openalex_limit_credits",
              "openalex_remaining_credits",
              "openalex_cost_credits",
              "openalex_reset_seconds",
              "retry_after"
            ]
          }
        },
        "reset_after_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 172800
        }
      }
    },
    "worker_scholarly_observations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scholarly_attempt",
        "provider_limits"
      ],
      "properties": {
        "scholarly_attempt": {
          "$ref": "#/$defs/scholarly_attempt"
        },
        "provider_limits": {
          "$ref": "#/$defs/worker_provider_limits"
        }
      }
    },
    "executor_scholarly_observations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scholarly_attempt",
        "quota",
        "provider_limits"
      ],
      "properties": {
        "scholarly_attempt": {
          "$ref": "#/$defs/scholarly_attempt"
        },
        "quota": {
          "$ref": "#/$defs/quota_observation"
        },
        "provider_limits": {
          "$ref": "#/$defs/provider_limit_observation"
        }
      }
    }
  }
}
