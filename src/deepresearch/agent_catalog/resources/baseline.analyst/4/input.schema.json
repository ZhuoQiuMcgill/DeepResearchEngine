{
  "type": "object",
  "properties": {
    "question": {
      "type": "string"
    },
    "plan": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "A nonblank research objective; whitespace-only text is not an objective."
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 1,
            "description": "Nonblank, distinct text; UTF-8 encoded length must not exceed 1024 bytes."
          },
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true
        },
        "queries": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 4096,
            "minLength": 1,
            "description": "Nonblank, distinct text; UTF-8 encoded length must not exceed 4096 bytes."
          },
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true
        },
        "outline": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "description": "Nonblank, distinct text; UTF-8 encoded length must not exceed 256 bytes."
          },
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true
        }
      },
      "required": [
        "schema_version",
        "objective",
        "questions",
        "queries",
        "outline"
