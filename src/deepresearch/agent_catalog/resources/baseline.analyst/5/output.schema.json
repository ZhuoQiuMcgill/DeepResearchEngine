{
  "$defs": {
    "EvidenceReadRequest": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "range": {
          "$ref": "#/$defs/SourceRange"
        },
        "reason": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "range",
        "reason"
      ],
      "title": "EvidenceReadRequest",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "finding_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Finding Id",
          "type": "string"
        },
        "question": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "claim": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Claim",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        }
      },
      "required": [
        "finding_id",
        "question",
        "claim",
        "source_ids"
      ],
      "title": "Finding",
      "type": "object"
    },
    "SourceRange": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "lines",
            "pages"
          ],
          "title": "Kind",
          "type": "string"
        },
        "start": {
          "minimum": 1,
          "title": "Start",
          "type": "integer"
        },
        "end_exclusive": {
          "minimum": 1,
          "title": "End Exclusive",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "start",
        "end_exclusive"
      ],
      "title": "SourceRange",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "maxItems": 24,
      "minItems": 1,
      "title": "Findings",
      "type": "array"
    },
    "gaps": {
      "items": {
        "type": "string"
      },
      "maxItems": 8,
      "title": "Gaps",
      "type": "array"
    },
    "follow_up_queries": {
      "items": {
        "type": "string"
      },
      "maxItems": 2,
      "title": "Follow Up Queries",
      "type": "array"
    },
    "sufficient": {
      "title": "Sufficient",
      "type": "boolean"
    },
    "follow_up_reads": {
      "items": {
        "$ref": "#/$defs/EvidenceReadRequest"
      },
      "maxItems": 8,
      "title": "Follow Up Reads",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "findings",
    "gaps",
    "follow_up_queries",
    "sufficient",
    "follow_up_reads"
  ],
  "title": "DistilledAnalysis",
  "type": "object"
}
