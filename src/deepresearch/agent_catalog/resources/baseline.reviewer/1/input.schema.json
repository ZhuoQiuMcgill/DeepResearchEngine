{
  "type": "object",
  "properties": {
    "question": {
      "type": "string"
    },
    "plan": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "A nonblank research objective; whitespace-only text is not an objective."
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 1,
            "description": "Nonblank, distinct text; UTF-8 encoded length must not exceed 1024 bytes."
          },
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true
        },
        "queries": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 4096,
            "minLength": 1,
            "description": "Nonblank, distinct text; UTF-8 encoded length must not exceed 4096 bytes."
          },
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true
        },
        "outline": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "description": "Nonblank, distinct text; UTF-8 encoded length must not exceed 256 bytes."
          },
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true
        }
      },
      "required": [
        "schema_version",
        "objective",
        "questions",
        "queries",
        "outline"
      ],
      "additionalProperties": false
    },
    "analysis": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "finding_id": {
                "type": "string"
              },
              "question": {
                "type": "string"
              },
              "claim": {
                "type": "string",
                "maxLength": 2048
              },
              "source_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "maxItems": 8
              }
            },
            "required": [
              "finding_id",
              "question",
              "claim",
              "source_ids"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 24
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1024
          },
          "minItems": 0,
          "maxItems": 8
        },
        "follow_up_queries": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 4096
          },
          "minItems": 0,
          "maxItems": 2
        },
        "sufficient": {
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "findings",
        "gaps",
        "follow_up_queries",
        "sufficient"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "string",
      "maxLength": 65536
    },
    "report": {
      "type": "string",
      "maxLength": 65536
    }
  },
  "required": [
    "question",
    "plan",
    "analysis",
    "evidence",
    "report"
  ],
  "additionalProperties": false
}
