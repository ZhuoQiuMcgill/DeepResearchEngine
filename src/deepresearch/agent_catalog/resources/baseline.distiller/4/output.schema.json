          "type": "string"
        },
        "claim": {
          "maxLength": 1536,
          "minLength": 1,
          "title": "Claim",
          "type": "string"
        },
        "segment_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Segment Id",
          "type": "string"
        },
        "quote": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "question",
        "claim",
        "segment_id",
        "quote"
