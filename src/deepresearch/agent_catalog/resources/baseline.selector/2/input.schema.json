{
  "type": "object",
  "properties": {
    "question": {
      "type": "string"
    },
    "plan": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "A nonblank research objective; whitespace-only text is not an objective."
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 1,
            "description": "Nonblank, distinct text; UTF-8 encoded length must not exceed 1024 bytes."
          },
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true
        },
        "queries": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 4096,
            "minLength": 1,
            "description": "Nonblank, distinct text; UTF-8 encoded length must not exceed 4096 bytes."
          },
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true
        },
        "outline": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "description": "Nonblank, distinct text; UTF-8 encoded length must not exceed 256 bytes."
          },
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true
        }
      },
      "required": [
        "schema_version",
        "objective",
        "questions",
        "queries",
        "outline"
      ],
      "additionalProperties": false
    },
    "candidates": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "url": {
            "type": "string"
          },
          "work_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "snippet": {
            "type": "string"
          },
          "bibliography": {
            "type": "object",
            "additionalProperties": {}
          },
          "discovery": {
            "type": "object",
            "additionalProperties": {}
          },
          "metadata_notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "candidate_id",
          "url",
          "work_id",
          "title",
          "snippet",
          "bibliography",
          "discovery",
          "metadata_notes"
        ],
        "additionalProperties": {}
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": {}
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "budget": {
      "type": "object",
      "properties": {
        "remaining_fetches": {
          "type": "integer",
          "minimum": 0
        },
        "batch_fetch_limit": {
          "type": "integer",
          "minimum": 0
        },
        "round": {
          "type": "integer",
          "minimum": 1
        },
        "max_rounds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "remaining_fetches",
        "batch_fetch_limit",
        "round",
        "max_rounds"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "properties": {
        "total_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "delivered_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "omitted_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "truncated_candidates": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "total_candidates",
        "delivered_candidates",
        "omitted_candidates",
        "truncated_candidates"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "question",
    "plan",
    "candidates",
    "history",
    "gaps",
    "budget",
    "coverage"
  ],
  "additionalProperties": false
}
