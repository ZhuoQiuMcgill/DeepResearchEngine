{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "search_topic": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Explicit subject for lexical title/snippet screening; when absent, simple definition subjects and expanded parenthetical names are inferred."
    },
    "max_results": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "default": 5
    },
    "max_sources": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20,
      "default": 20
    },
    "max_rounds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2,
      "default": 2
    },
    "max_queries": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4,
      "default": 2
    },
    "max_report_attempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4,
      "default": 4
    },
    "context_tokens": {
      "type": "integer",
      "minimum": 512,
      "maximum": 196608,
      "default": 131072
    },
    "max_context_bytes": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 786432,
      "default": 524288
    },
    "max_scan_bytes": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 4194304,
      "default": 1048576,
      "description": "Archived source bytes read per document, with explicit partial coverage if capped."
    },
    "strict_tokens": {
      "type": "boolean",
      "default": false
    },
    "queries": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "search_tools": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "web.search",
          "scholar.crossref.search",
          "scholar.openalex.search"
        ]
      }
    },
    "source_urls": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8192
      }
    },
    "parallel_agents": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8,
      "default": 4
    },
    "max_distillation_calls": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20,
      "default": 20
    },
    "recovery_queries": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4,
      "default": 4
    },
    "min_substantive_sources": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "default": 2
    }
  }
}
