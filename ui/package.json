{
  "name": "inse-691-project",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src docs *.json *.ts *.html README.md",
    "model:start": "node scripts/start-model.mjs",
    "predev": "npm run model:start",
    "model:ninfer": "node scripts/start-model.mjs --engine ninfer --switch",
    "model:q4": "node scripts/start-model.mjs --engine llama --switch"
  },
  "dependencies": {
    "@xyflow/react": "^12.3.5",
    "cheerio": "^1.2.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.9",
    "typescript": "^5.6.3",
    "vite": "^6.1.0",
    "vitest": "^5.0.2"
  }
}
