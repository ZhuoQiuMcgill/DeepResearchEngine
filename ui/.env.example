# Local model URL, including /v1. No trailing /chat/completions.
PLANNER_BASE_URL=http://127.0.0.1:18086/v1
PLANNER_MODEL=qwen38-ninfer-256k
# Optional local authentication; only read on the server.
PLANNER_API_KEY=

# Optional for llama.cpp Qwen services: omit the reasoning preamble.
PLANNER_ENABLE_THINKING=false

PLANNER_MIN_CONTEXT=262144



PLANNER_ENGINE=ninfer
# Optional GPU index or UUID for the NInfer launcher. Set this for your machine.
PLANNER_CUDA_VISIBLE_DEVICES=
# Optional managed runtime paths. Use paths visible inside WSL on Windows.
PLANNER_NINFER_BIN=
PLANNER_NINFER_MODEL_PATH=
PLANNER_NINFER_LIBRARY_PATH=
PLANNER_LLAMA_BIN=
PLANNER_LLAMA_MODEL_PATH=

# Optional API model profile. Use an OpenAI-compatible base URL and model ID.
# Fill this profile in .env.local. Never prefix the key with VITE_.
PLANNER_REMOTE_BASE_URL=
PLANNER_REMOTE_MODEL=
PLANNER_REMOTE_API_KEY=

